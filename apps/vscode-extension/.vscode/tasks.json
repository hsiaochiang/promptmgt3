{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "watch",
            "problemMatcher": {
                "owner": "typescript",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
                    "file": 1,
                    "location": 2,
                    "severity": 3,
                    "code": 4,
                    "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": {
                        "regexp": "^\\s*\\d{1,2}:\\d{1,2}:\\d{1,2}\\s+[AP]M - Starting compilation in watch mode\\.\\.\\."
                    },
                    "endsPattern": {
                        "regexp": "^\\s*\\d{1,2}:\\d{1,2}:\\d{1,2}\\s+[AP]M - Found \\d+ errors?\\. Watching for file changes\\."
                    }
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}