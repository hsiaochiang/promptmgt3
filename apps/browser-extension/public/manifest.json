{
  "manifest_version": 3,
  "name": "WOS Prompt Hub",
  "version": "1.0.0",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ]
}